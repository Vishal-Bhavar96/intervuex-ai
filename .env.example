# Database Connection
DATABASE_URL=sqlite:///./intervuex.db
# PostgreSQL Example: postgresql://intervuex_user:intervuex_pass@localhost:5432/intervuex_db

# Security & Secrets
JWT_SECRET=intervuex-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration ("gemini", "openai", "mock", or "auto")
AI_PROVIDER=auto
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL_NAME=gemini-1.5-flash

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Storage
MAX_FILE_SIZE_MB=10
